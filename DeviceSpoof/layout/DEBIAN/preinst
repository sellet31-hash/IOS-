#!/bin/sh
inject="/var/jb/usr/lib/TweakInject"
libs="/var/jb/Library/MobileSubstrate/DynamicLibraries"

mkdir -p /var/jb/usr/lib /var/jb/tmp "$libs"

if [ -L "$inject" ] && [ ! -d "$inject" ]; then
	rm -f "$inject"
fi

if [ ! -e "$inject" ]; then
	ln -s "$libs" "$inject"
fi

if [ -L "$inject" ] && [ ! -d "$inject" ]; then
	rm -f "$inject"
	mkdir -p "$inject"
fi

exit 0
