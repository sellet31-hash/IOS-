#!/bin/sh
inject="/var/jb/usr/lib/TweakInject"
libs="/var/jb/Library/MobileSubstrate/DynamicLibraries"

mkdir -p /var/jb/tmp

if [ ! -f "$inject/DeviceSpoof.dylib" ] && [ -f "$libs/DeviceSpoof.dylib" ]; then
	if [ -L "$inject" ] && [ ! -d "$inject" ]; then
		rm -f "$inject"
	fi
	if [ ! -e "$inject" ]; then
		ln -s "$libs" "$inject"
	fi
	if [ -d "$inject" ] && [ ! -L "$inject" ]; then
		cp -f "$libs/DeviceSpoof.dylib" "$libs/DeviceSpoof.plist" "$inject/"
	fi
fi

if [ -f "$inject/DeviceSpoof.dylib" ] && [ ! -L "$inject" ]; then
	mkdir -p "$libs"
	cp -f "$inject/DeviceSpoof.dylib" "$inject/DeviceSpoof.plist" "$libs/"
fi

exit 0
