#!/bin/sh
src="/var/jb/Library/MobileSubstrate/DynamicLibraries"
inject="/var/jb/usr/lib/TweakInject"

if [ ! -f "$src/DeviceSpoof.dylib" ]; then
	exit 0
fi

# A working symlink already exposes DynamicLibraries. A missing or broken
# TweakInject is why ElleKit never loads the tweak, so the model stays real.
if [ -L "$inject" ] && [ -d "$inject" ]; then
	exit 0
fi

if [ -L "$inject" ]; then
	rm -f "$inject"
fi

mkdir -p "$inject"
cp -f "$src/DeviceSpoof.dylib" "$src/DeviceSpoof.plist" "$inject/"
exit 0
